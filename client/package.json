{
  "name": "shbs-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:openapi:json": "swagger2openapi ../server/docs/swagger.json -o ../server/docs/openapi.json",
    "generate:openapi:yaml": "swagger2openapi ../server/docs/swagger.json -o ../server/docs/openapi.yaml --yaml",
    "generate:openapi": "npm run generate:openapi:json && npm run generate:openapi:yaml",
    "generate:api": "swagger-typescript-api -p ../server/docs/openapi.json -o ./generated -n api.ts --no-client"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.3.0",
    "@tanstack/react-query": "^5.62.2",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.1",
    "react-redux": "^9.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "swagger-typescript-api": "^13.0.22",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
